# Copy to .env on the farm PC:   Copy-Item .env.example .env
# NEVER commit .env and never paste it into chat/e-mail — it holds the service-role key.
# Format: KEY=value, one per line, no quotes, no spaces around "=", no trailing spaces.
# The values below are the READ-ONLY profile: nothing is written to DelPro.

# --- GVET PRO (Supabase) ------------------------------------------------------
# The Supabase project of THIS farm's GVET (Settings -> API -> Project URL).
SUPABASE_URL=https://<project-ref>.supabase.co
# Settings -> API -> service_role key. Worker-only RPCs are granted to service_role only.
SUPABASE_SERVICE_ROLE_KEY=
# Shown on the admin screen; use the PC's hostname.
WORKER_ID=<farm-pc-hostname>

# --- DelPro herd source (animals + groups -> GVET) ------------------------------
# off   = no herd sync (catalog-only install; use until queries/*.sql are discovered for this PC)
# mssql = read DelPro's local SQL Server (needs queries/animals.sql filled in + a read-only SQL login)
# json  = read DELPRO_JSON_FILE (testing only)
DELPRO_SOURCE=off
DELPRO_JSON_FILE=./test/fixtures/herd.json
DELPRO_SQL_SERVER=localhost
DELPRO_SQL_INSTANCE=SQLEXPRESS
DELPRO_SQL_DATABASE=DDM
# SQL login with db_datareader only. Windows authentication is not supported by the driver.
DELPRO_SQL_USER=
DELPRO_SQL_PASSWORD=
INBOUND_INTERVAL_MIN=30

# --- Treatments GVET -> DelPro ------------------------------------------------
# off     = never claim or write treatments (keep this until the farm agrees otherwise)
# dry-run = log only, don't claim
# sql     = DelPro SQL write via queries/*.sql (placeholders — refused until filled in)
# gateway = the full treatment via the Gateway: DiagnosesAndTreatmentEvent + medicine records, read back
#           (needs a farm-verified treatment-model.json; without it nothing is sent and jobs wait in GVET)
OUTBOUND_MODE=off
OUTBOUND_INTERVAL_SEC=5

# --- DelPro catalog via the local Gateway SOAP service --------------------------
# off | gateway   (gateway = GetData reads of Drug, DrugParameters, Diagnosis, Treatment, TreatmentDrugUsage, Animal)
CATALOG_SOURCE=gateway
DELPRO_GATEWAY_URL=http://127.0.0.1:28080/GatewaySoapService
# Local Gateway account (e.g. HerdNav). Leave PASSWORD empty if the account has none.
DELPRO_GATEWAY_USER=
DELPRO_GATEWAY_PASSWORD=
# Any GUID; a fresh one per process when empty.
DELPRO_GATEWAY_CLIENT_ID=
DELPRO_GATEWAY_TIMEOUT_MS=30000
# Retries of a failed READ (writes are never retried).
DELPRO_GATEWAY_READ_RETRIES=2
# Gateway Animal property with the official ear tag (ORN). Links animals that have no short DelPro Number.
# If DelPro rejects the name, the worker falls back to Number only and logs it. Empty = Number only.
DELPRO_GATEWAY_ANIMAL_ORN_PROPERTY=OfficialRegNumber
CATALOG_INTERVAL_MIN=1440
# `top` per GetData. A read returning this many rows is treated as truncated (GVET removes nothing for that type).
CATALOG_MAX_ROWS=5000
# Rows one GetData is assumed to return at most (this Gateway returned exactly 1000 DrugParameters).
# A read reaching it is never taken as the whole catalog. Raise only after verifying the Gateway returns more.
CATALOG_GATEWAY_ROW_CAP=1000
# GVET -> DelPro catalog writes. Keep false. Even when true, GVET hands out only test jobs and operations
# validated by them, and only while "Rašymas į DelPro katalogą" is switched on in GVET.
CATALOG_WRITE_ENABLED=false

# --- CMS atskyrimai (GVET -> DelPro AnimalActionSetting SortCow) -----------------
# off | dry-run | gateway. Keep off until the supervised single-animal test (npm run cms:write-one).
# Independent of OUTBOUND_MODE (treatments).
CMS_OUTBOUND_MODE=off
CMS_POLL_INTERVAL_SEC=5
# Known sort area (Rūšiavimo patalpa 1). Informational only: it is NOT sent and NOT proven to route the cow.
CMS_DEFAULT_SORT_AREA_KEY=1
# 0051 (0.4.0): approved jobs claimed per tick (at most) and processed at once — small, so DelPro is never flooded.
CMS_BATCH_LIMIT=10
CMS_CONCURRENCY=2
# DelPro SortCow state of GVET's CMS animals only (batches, open jobs, GVET-written, live in DelPro, asked for), each animal
# re-read when older than CMS_LIVE_INTERVAL_MIN minutes (0 = only when GVET asks); CMS_REFRESH_BATCH animals per round,
# a round every CMS_REFRESH_POLL_SEC. Read-only. The whole-DelPro scan is `npm run cms:live` only (optional diagnostic).
CMS_LIVE_INTERVAL_MIN=60
CMS_REFRESH_BATCH=50
CMS_REFRESH_POLL_SEC=30
# Limits of the optional full scan (`npm run cms:live`). DelPro 10.9 fails GetData AnimalMilkSetting [Key, Animal] above ~1000 rows.
CMS_LIVE_MAX_ROWS=20000
CMS_LIVE_MILK_BULK_TOP=1000
CMS_LIVE_CONCURRENCY=3
CMS_LIVE_READ_ATTEMPTS=2

# --- gateway-discover only ------------------------------------------------------
# Rows saved per catalog type by `npm run gateway-discover` (default 5).
SAMPLE_TOP=5

# --- Sėklinimai: DelPro -> GVET (0053, worker 0.5.0) -------------------------------
# off | gateway. READ-ONLY towards DelPro (InseminationEvent + AnimalEvent of GVET-linked cows -> GVET Sėklinimas).
# Independent of OUTBOUND_MODE (treatments) and CMS_OUTBOUND_MODE. Test first: npm run insemination:preview / :sync-one.
INSEMINATION_SOURCE=off
# a round every INSEMINATION_POLL_SEC: at most INSEMINATION_BATCH cows, INSEMINATION_CONCURRENCY at a time. A cow is re-read when
# its last complete read is older than INSEMINATION_INTERVAL_MIN; a failed / incomplete one after INSEMINATION_RETRY_MIN.
INSEMINATION_POLL_SEC=60
INSEMINATION_BATCH=20
INSEMINATION_CONCURRENCY=3
INSEMINATION_INTERVAL_MIN=360
INSEMINATION_RETRY_MIN=30
# InseminationEvent rows per cow; reaching the limit -> one re-read with the max; still full = incomplete (never "all of them")
INSEMINATION_EVENT_TOP=100
INSEMINATION_EVENT_MAX_TOP=1000
# dates of events this recent are re-read even when GVET has them (late corrections); events older than the backfill window
# (months, by the Lithuanian date; 0 = all) are not imported
INSEMINATION_OVERLAP_DAYS=14
INSEMINATION_BACKFILL_MONTHS=24
# Semen catalog "<name>,<comment>" (verified: Semen [Key, SemenName, Comment]; Key 2111 = Heavenly). Empty = this default.
INSEMINATION_SEMEN_PROPERTIES=SemenName,Comment
