# Copy to .env.local and fill in from the Supabase project dashboard
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Pajamavimas: PDF invoice parsing (Priedas §2.11) ---------------------
# Hardcoded in src/lib/invoice-parse-client.ts (shared n8n host, same as the
# sibling projects) — not a secret, so no env var here.

# --- DelPro (Priedas §3-§4) -------------------------------------------------
# Nothing for the web app: the worker on the farm PC (delpro-worker/) calls
# the database directly with its own .env. See delpro-worker/README.md.
